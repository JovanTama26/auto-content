{
  "manifest_version": 3,
  "name": "Content Auto - AI Studio Bridge",
  "version": "1.0.0",
  "description": "Pondasi otomasi Google AI Studio terhubung ke Supabase (schema autocontent)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka Content Auto Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "debugger",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://elevenlabs.io/*",
    "https://n8n.riztama.my.id/*",
    "https://supabase.riztama.my.id/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "lib/supabase.js",
        "lib/prompt-generator.js",
        "content.js",
        "modules/chunk-validator.js",
        "modules/script-generator.js",
        "modules/mapping-generator.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*"
      ],
      "all_frames": true,
      "js": [
        "picker.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://elevenlabs.io/*"
      ],
      "js": [
        "content.js",
        "modules/elevenlabs-signup.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
