{
  "name": "content-auto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dashboard"
  ],
  "description": "FFmpeg-based automated content rendering engine and Electron dashboard for YouTube",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && npm --workspace=dashboard exec -- tsc --noEmit",
    "dev": "npm --workspace=dashboard run dev",
    "dashboard": "npm --workspace=dashboard run dev",
    "dashboard:vite": "npm --workspace=dashboard run dev:vite",
    "dashboard:build": "npm --workspace=dashboard run build",
    "render": "npx tsx cli/index.ts render",
    "render:alurfilm": "npx tsx cli/render-alurfilm.ts render",
    "validate": "npx tsx cli/index.ts validate",
    "test:alurfilm": "npx tsx lib/alurfilm/character-overlay.test.ts",
    "db:sync": "npx tsx scripts/sync-to-supabase.ts",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "bridge": "npx tsx scripts/bridge-server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "commander": "^12.0.0",
    "playwright": "^1.61.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}