{
  "name": "content-auto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dashboard"
  ],
  "description": "Remotion-based automated content rendering engine for YouTube",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "npm --workspace=dashboard run dev",
    "dashboard": "npm --workspace=dashboard run dev",
    "dashboard:vite": "npm --workspace=dashboard run dev:vite",
    "dashboard:build": "npm --workspace=dashboard run build",
    "render": "npx tsx cli.ts render",
    "validate": "npx tsx cli.ts validate",
    "aistudio": "npx tsx playwright/aistudio.ts",
    "gemini": "npx tsx playwright/gemini.ts",
    "google:login": "npx tsx playwright/init-google-login.ts",
    "aistudio:login": "npx tsx playwright/init-login.ts",
    "aistudio:init": "npx tsx playwright/init-login.ts",
    "aistudio:prompt": "npx tsx playwright/actions/input-prompt.ts",
    "aistudio:attach": "npx tsx playwright/actions/attach-file.ts",
    "aistudio:drive": "npx tsx playwright/actions/attach-drive-file.ts",
    "aistudio:drive-codegen": "npx tsx playwright/test-attach-drive-only.ts",
    "aistudio:submit": "npx tsx playwright/actions/submit-and-extract.ts",
    "aistudio:pipeline": "npx tsx playwright/pipelines/analysis-pipeline.ts",
    "playwright:init": "npx tsx playwright/cli.ts init-user-data",
    "playwright:check": "npx tsx playwright/cli.ts check-session",
    "playwright:create": "npx tsx playwright/cli.ts create-project",
    "playwright:generate": "npx tsx playwright/cli.ts generate-images",
    "flow:login": "npx tsx playwright/init-flow-login.ts",
    "elevenlabs:signup": "npx tsx playwright/auto-signup-elevenlabs.ts",
    "elevenlabs:e2e": "npx tsx playwright/tests/test-elevenlabs-tts-e2e.ts",
    "keywords:shorts": "npx tsx dashboard/scripts/generate-shorts-keywords.ts",
    "db:sync": "npx tsx scripts/sync-to-supabase.ts",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "bridge": "npx tsx scripts/bridge-server.ts",
    "youtube:channels": "npx tsx playwright/youtube-channel-creator.ts",
    "youtube:login": "npx tsx playwright/init-youtube-login.ts",
    "youtube:subscribe": "npx tsx playwright/youtube-auto-subscriber.ts",
    "youtube:unsubscribe": "npx tsx playwright/youtube-auto-unsubscriber.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "commander": "^12.0.0",
    "playwright": "^1.61.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "postgres": "^3.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
